<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ardour" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Dark status and navigation icons on the light page (DP14). Static until theming (Phase 9). -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Ardour.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Light status and navigation icons on the dark page (DECISIONS.md 153). -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
